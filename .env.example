# SQLite file. Use an absolute path on the Raspberry Pi.
DATABASE_PATH=data/cherrypicker.db

# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=

# Exact origin users open in their browser. Use the public HTTPS URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Set to false after creating the intended accounts on a small public server.
ALLOW_SIGN_UP=true
ADMIN_EMAILS=admin@example.com
# Optional fallback for single-owner installs. Requires closed signup and an empty ADMIN_EMAILS.
ADMIN_ACCESS_MODE=

# Optional OpenAI Responses API for ambiguous promotions and card benefit extraction.
# Keep this server-only; never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
PROMOTION_AI_MODEL=gpt-5.6-luna
PROMOTION_AI_REASONING_EFFORT=low
# Optional overrides for SKT brands that the deterministic parser cannot structure.
PROMOTION_SKT_AI_MODEL=gpt-5.6-luna
PROMOTION_SKT_AI_REASONING_EFFORT=medium
PROMOTION_SKT_AI_MAX_CALLS=15
PROMOTION_SKT_AI_MAX_SOURCE_CHARS=24000
CARD_BENEFIT_AI_MODEL=gpt-5.6-luna
CARD_BENEFIT_AI_REASONING_EFFORT=medium
CARD_BENEFIT_AI_MAX_SOURCE_CHARS=240000
# Maximum changed cards sent to the two-stage AI extractor in one batch verification.
CARD_BENEFIT_BATCH_MAX_AI_CARDS=2
# Optional official product-guide PDF. Only HTTPS shinhancard.com URLs are accepted.
SHINHAN_SOL_TRAVEL_GUIDE_PDF_URL=
PROMOTION_AI_MAX_CALLS=25
