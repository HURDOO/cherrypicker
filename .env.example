# SQLite file. Use an absolute path on the Raspberry Pi.
DATABASE_PATH=data/cherrypicker.db

# Generate with: npx auth@latest secret
BETTER_AUTH_SECRET=

# Exact origin users open in their browser. Use the public HTTPS URL in production.
BETTER_AUTH_URL=http://localhost:3000

# Set to false after creating the intended accounts on a small public server.
ALLOW_SIGN_UP=true
ADMIN_EMAILS=admin@example.com
# Optional fallback for single-owner installs. Requires closed signup and an empty ADMIN_EMAILS.
ADMIN_ACCESS_MODE=

# Optional semantic classifier for ambiguous promotion wording.
# Without a key, collection continues with the conservative rule classifier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
CARD_BENEFIT_AI_MODEL=gemini-3.6-flash
# Optional official product-guide PDF. Only HTTPS shinhancard.com URLs are accepted.
SHINHAN_SOL_TRAVEL_GUIDE_PDF_URL=
PROMOTION_AI_MAX_CALLS=25
