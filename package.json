{
  "name": "cherrypicker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run db:setup && WATCHPACK_POLLING=true next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "benchmark:recommendations": "tsx scripts/benchmark-recommendations.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:verify-backup": "tsx scripts/verify-db-backup.ts",
    "promotions:collect": "tsx scripts/collect-promotions.ts",
    "cards:collect": "tsx scripts/collect-card-benefits.ts",
    "cards:verify": "tsx scripts/collect-card-benefits.ts --all",
    "cards:verify:scheduled": "tsx scripts/collect-card-benefits.ts --all --scheduled"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "better-auth": "^1.6.23",
    "better-sqlite3": "^12.11.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.562.0",
    "next": "16.3.1",
    "openai": "^7.5.0",
    "pdfjs-dist": "4.10.38",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
